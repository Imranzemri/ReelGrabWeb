# ───────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in real values.
# Never commit .env.local — it is gitignored.
# ───────────────────────────────────────────────────────────────

# --- Fetch provider (RapidAPI) ---
# The app calls a third-party RapidAPI downloader to resolve video URLs.
# 1. Create a free RapidAPI account: https://rapidapi.com
# 2. Subscribe to a social-media video downloader API (see README for picks).
# 3. Paste the key + host below.
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=social-download-all-in-one.p.rapidapi.com

# Which provider adapter to use. Currently supported: "aio"
# (See lib/providers.ts — add your own adapter and switch here.)
FETCH_PROVIDER=aio

# --- Public site config (used for SEO / canonical URLs) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=ReelGrab

# --- Google AdSense ---
# Your publisher ID, e.g. "ca-pub-1234567890123456"
# Leave blank to hide all ad slots (useful in dev / before approval).
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad slot IDs (create these in your AdSense dashboard).
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
